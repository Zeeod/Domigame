# ==============================================================================
# SERVER CONFIGURATION (Used by Node.js at runtime)
# ==============================================================================
PORT=3005
NODE_ENV=production

# The public URL of your client (used for CORS)
# If serving from the same domain/port, "*" or the subdomain is fine.
CLIENT_URL=https://dominion.zeeod.fr

# Socket.IO path (must match client)
SOCKET_PATH=/socket.io/


# ==============================================================================
# CLIENT CONFIGURATION (Used by Vite at BUILD time)
# ==============================================================================

# Public URL of the server. 
# LEAVE EMPTY if the client is served by the same server (recommended for Docker).
VITE_SERVER_URL=

# Socket.IO path (must match server)
VITE_SOCKET_PATH=/socket.io/
